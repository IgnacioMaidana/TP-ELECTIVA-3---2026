# Copiar este archivo como .env y completar los valores. NUNCA subir el .env a git.

# --- LLM (Gemini, nivel gratuito) ---
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
LLM_MODEL=
LLM_PAUSA_SEGUNDOS=4

# --- SQL Server ---
DB_SERVER=localhost
DB_NAME=EcommerceTech
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=yes
# Conexion de administracion (solo scripts de carga de datos)
DB_ADMIN_TRUSTED=yes
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
# Conexion de solo lectura (la usa el agente)
DB_USER=agente_ro
DB_PASSWORD=

# --- Herramienta SQL ---
SQL_MAX_ROWS=100
SQL_RETRIES=2
SQL_TIMEOUT_SEGUNDOS=15

# --- RAG ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
RAG_UMBRAL=0.36
RAG_CHUNK_CHARS=450
RAG_SOLAPE_CHARS=80

# --- Observabilidad (opcional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
